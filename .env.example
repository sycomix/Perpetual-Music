# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here
LIVE_CHAT_ID=your_live_chat_id_here
YOUTUBE_STREAM_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=your_stream_key_here
# Required only when YOUTUBE_MANAGE_BROADCAST=true. Obtain via OAuth2 with
# the YouTube scope; an API key cannot create or transition broadcasts.
YOUTUBE_MANAGE_BROADCAST=false
YOUTUBE_OAUTH_ACCESS_TOKEN=

# Local/LAN test streaming. Set STREAM_OUTPUT=local, then open
# http://<this-computer's-LAN-IP>:8090/stream.mp3 in VLC or iTunes.
STREAM_OUTPUT=rtmp
LOCAL_STREAM_HOST=0.0.0.0
LOCAL_STREAM_PORT=8090

# Manual steering API, active for both RTMP and local stream modes.
# Keep the default loopback binding, or set 0.0.0.0 for LAN control and use a token.
STEERING_HOST=127.0.0.1
STEERING_PORT=8091
STEERING_TOKEN=

# Vibe Analyzer Configuration (Unsloth Studio / OpenAI-compatible API)
VIBE_API_URL=http://localhost:8000
VIBE_API_MODEL=unsloth-mistral

# Music Generator Configuration (ACE-Step)
ACE_STEP_URL=http://127.0.0.1:8002

# Stream Configuration
DEFAULT_ENERGY=3
DEFAULT_GENRE=lofi
DEFAULT_TAGS=chill,lofi hip hop,relaxed
DEFAULT_VOCAL_STYLE=instrumental
DEFAULT_DIRECTION=default chill lofi beat
DEFAULT_LYRICS_LANGUAGE=en

# Chat Monitor Configuration
CHAT_POLL_INTERVAL=45
CHAT_MAX_RESULTS=20

# Music Generator Configuration
GENERATION_INTERVAL=5
DEFAULT_DURATION=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=stream.log
